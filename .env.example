# Docker Compose: copie para .env antes de iniciar.
# Dados e senhas públicos de demonstração, apenas em localhost.
APP_DEMO=true
MATCH_MODE=MEDIATED
COMMISSION_MODE=INCLUDED
# Para desabilitar demonstração, forneça senhas próprias (mínimo 12 caracteres).
BRAND_PASSWORD=
OPS_PASSWORD=
CREATOR_PASSWORD=
# Somente ao usar compose.postgres.yaml: defina uma senha para o banco local.
POSTGRES_PASSWORD=
# Apenas na primeira adoção de um banco do MVP anterior, após backup e revisão do schema.
DATABASE_BASELINE=false
